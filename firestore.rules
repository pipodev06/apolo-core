rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Reglas de Firestore — Sistema de Tickets
//
// AUTENTICACIÓN: login nativo de Firebase Auth con email/contraseña (email
// interno `usuario@apolo.local`, ver src/lib/cuentas.ts). No hay custom
// claims: el rol, el personalId y si la cuenta está activa se leen de
// users/{request.auth.uid} en cada regla. Una cuenta de Auth sin doc en
// users (ej. alguien que se registró por su cuenta con la API key) no tiene
// acceso a nada; desactivar o mandar a la papelera una cuenta le corta el
// acceso al instante.
//
// Toda LECTURA exige sesión de una cuenta activa, salvo `publico/estado`
// ({inicializado}: lo leen Login y SetupGuard antes de que exista nadie logueado).
//
// Lo que hacen estas reglas en general:
//   • Validar forma/tipos de los datos en cada escritura (evita basura).
//   • Restringir valores de enums (urgency/status/role).
//   • Borrado FÍSICO solo de lo que ya está en la papelera (deletedAt) y
//     solo un admin; las cuentas (users) pasan por la Cloud Function
//     eliminarCuenta, que también borra su login de Auth.
//   • Historial (eventos) y notificaciones se escriben desde el cliente en
//     la MISMA escritura que el ticket o comentario que los origina.
//   • Acotar el tamaño de los textos.
//   • Tickets: cada usuario ve solo los suyos (creados o asignados a él);
//     los admins ven todos.
//   • Gestión (users, access, personal, catálogos, config, update de
//     tickets) exige rol admin/super_admin (leído de users/{uid}).
//   • Setup inicial (config/app + primer super_admin) solo mientras
//     config/app no exista.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function nonEmptyStr(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    function rutaUser(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Doc users/{uid} de quien hace la petición (Firestore cachea el get
    // dentro de una misma petición: varias reglas que lo usan = 1 lectura).
    function perfil() {
      return get(rutaUser(request.auth.uid)).data;
    }

    // Sesión de Auth + cuenta existente, activa y fuera de la papelera (si el
    // doc no existe, el get falla y la regla deniega).
    function logueado() {
      return request.auth != null
             && perfil().get('active', false) == true
             && perfil().get('deletedAt', null) == null;
    }

    function rol() {
      return perfil().get('role', '');
    }

    function miPersonalId() {
      return perfil().get('personalId', '');
    }

    function usernameDe(uid) {
      return get(rutaUser(uid)).data.username;
    }

    function esAdmin() {
      return logueado() && rol() in ['admin', 'super_admin'];
    }

    // Quién puede ver un ticket: admins (todos), quien lo creó, y el técnico
    // asignado (personalId de su cuenta). Un usuario no ve tickets ajenos.
    // Acceso directo a campos del ticket (no .get()) para que Firestore pueda
    // validar las queries filtradas por createdBy / assignedTo contra esta regla.
    function puedeVerTicket(t) {
      return esAdmin()
             || t.createdBy == request.auth.uid
             || (miPersonalId() != '' && t.assignedTo == miPersonalId());
    }

    // Setup inicial en curso: la misma transacción crea config/app (que
    // todavía no existe), publico/estado y el primer super_admin.
    function enSetup() {
      return request.auth != null
             && !exists(/databases/$(database)/documents/config/app)
             && existsAfter(/databases/$(database)/documents/config/app)
             && existsAfter(/databases/$(database)/documents/publico/estado)
             && existsAfter(rutaUser(request.auth.uid))
             && getAfter(rutaUser(request.auth.uid)).data.role == 'super_admin';
    }

    function rutaTicket(id) {
      return /databases/$(database)/documents/tickets/$(id);
    }

    // El ticket se modifica en esta misma petición, firmado por quien la hace
    // (updatedAt y modificadoPor.en son serverTimestamp = request.time), y
    // cambia algo que va al historial: un update vacío no sirve de ancla.
    function ticketCambiadoAhora(id) {
      let t = getAfter(rutaTicket(id)).data;
      return t.get('updatedAt', null) == request.time
             && t.get('modificadoPor', {}).get('id', '') == request.auth.uid
             && t.modificadoPor.get('en', null) == request.time
             && t.diff(get(rutaTicket(id)).data).affectedKeys().hasAny(['status', 'urgency', 'categoria', 'assignedTo', 'solutionDescription']);
    }

    // Destinatario legítimo de una notificación del ticket t: cuenta activa
    // que es su creador, el técnico asignado o un admin.
    function destinatarioValido(uid, t) {
      let d = get(rutaUser(uid)).data;
      return d.get('active', false) == true
             && d.get('deletedAt', null) == null
             && (uid == t.createdBy
                 || (d.get('personalId', '') != '' && d.personalId == t.get('assignedTo', ''))
                 || d.get('role', '') in ['admin', 'super_admin']);
    }

    // Permiso "Subir imágenes" de la Matriz de Accesos (access/{uid}). El
    // super_admin siempre puede; un admin solo si se lo dio un super_admin.
    function puedeSubirImagenes() {
      return rol() == 'super_admin'
             || get(/databases/$(database)/documents/access/$(request.auth.uid)).data.sections
                  .get('subirImagenes', false) == true;
    }

    // ¿El update agrega imágenes a la lista `campo`? (quitar no requiere permiso)
    function agregaImagenes(campo) {
      return request.resource.data.get(campo, []).toSet()
               .difference(resource.data.get(campo, []).toSet()).size() > 0;
    }

    // La serie de los códigos de ticket se usa dentro de una regex (create de
    // tickets): solo letras y números, para que nadie la rompa con caracteres
    // especiales y deje a todos sin poder crear tickets.
    function serieValida(s) {
      return s is string && s.matches('^[A-Za-z0-9]{1,10}$');
    }

    function usernameValido(u) {
      return u is string && u.matches('^[a-zA-Z0-9._-]{3,60}$');
    }

    // Máquina de estados de ticket: no se puede saltar pasos hacia adelante
    // (pendiente → en_proceso/terminado directo, o asignado → terminado
    // directo) — hay que pasar por "asignado"/"en_proceso" en el camino.
    // Hacia atrás (incluido reabrir un terminado) no tiene restricción:
    // decisión explícita del usuario, para no trabar correcciones de admin.
    // `modificadoPor` = quién hizo el último cambio de un ticket, para que el
    // historial lo muestre. Desde el cliente solo se puede firmar como uno
    // mismo; la IA (Admin SDK) firma como {tipo: 'ia'} sin pasar por acá.
    function firmaValida() {
      return !('modificadoPor' in request.resource.data.diff(resource.data).affectedKeys())
             || (request.resource.data.modificadoPor.tipo == 'usuario'
                 && request.resource.data.modificadoPor.id == request.auth.uid
                 && request.resource.data.modificadoPor.nombre == usernameDe(request.auth.uid));
    }

    function transicionDeEstadoValida(actual, nuevo) {
      return actual == nuevo
             || !(
                  (actual == 'pendiente' && nuevo == 'en_proceso')
                  || (actual == 'pendiente' && nuevo == 'terminado')
                  || (actual == 'asignado' && nuevo == 'terminado')
                );
    }

    // ── users ──────────────────────────────────────────────────────────────
    // El id del doc es el uid de Firebase Auth. Las contraseñas las guarda
    // Firebase Auth, no Firestore. El username es también el email de login,
    // así que solo lo cambia la Cloud Function cambiarUsername (Admin SDK).
    match /users/{userId} {
      allow read: if logueado();

      function datosUserValidos() {
        let d = request.resource.data;
        return d.keys().hasOnly(['username', 'email', 'role', 'personalId', 'active', 'protegida',
                                 'deletedAt', 'createdAt', 'updatedAt'])
               && usernameValido(d.username)
               && d.role in ['super_admin', 'admin', 'usuario']
               && d.active is bool
               && d.get('protegida', false) is bool
               && (!('personalId' in d) || d.personalId is string)
               && (!('email' in d) || (d.email is string && d.email.size() <= 120));
      }

      // Create: (a) el primer super_admin durante el setup — su propio uid y
      // su usuario debe coincidir con el email de su sesión de Auth; o (b) un
      // admin creando una cuenta (la de Auth la crea antes desde el cliente).
      // Un admin solo crea cuentas "usuario": las admin y super_admin (y las
      // protegidas) las crea solo un super_admin.
      allow create: if datosUserValidos()
                    && request.resource.data.active == true
                    && request.resource.data.get('deletedAt', null) == null
                    && (
                         (enSetup()
                          && userId == request.auth.uid
                          && request.resource.data.role == 'super_admin'
                          && request.auth.token.email == request.resource.data.username.lower() + '@apolo.local')
                         || (esAdmin()
                             && (request.resource.data.role == 'usuario' || rol() == 'super_admin')
                             && (request.resource.data.get('protegida', false) == false || rol() == 'super_admin'))
                       );

      // Update: exige admin/super_admin. El username es inmutable desde el
      // cliente. Un admin solo edita cuentas "usuario" que siguen siendo
      // "usuario" (no puede degradar, promover ni tocar a otro admin), o su
      // propia cuenta sin cambiarse el rol; el resto, solo un super_admin.
      // Cuentas protegidas (ej. las cuentas de la demo pública): solo un
      // super_admin las modifica, y solo un super_admin pone o quita la marca.
      allow update: if esAdmin()
                    && datosUserValidos()
                    && request.resource.data.username == resource.data.username
                    && (resource.data.get('protegida', false) != true || rol() == 'super_admin')
                    && (request.resource.data.get('protegida', false) == resource.data.get('protegida', false)
                        || rol() == 'super_admin')
                    && (rol() == 'super_admin'
                        || (resource.data.role == 'usuario' && request.resource.data.role == 'usuario')
                        || (userId == request.auth.uid && request.resource.data.role == resource.data.role));

      // Sin borrado físico: desactivar (active=false) en su lugar.
      allow delete: if false;
    }

    // ── tickets ────────────────────────────────────────────────────────────
    match /tickets/{ticketId} {
      allow read: if logueado() && puedeVerTicket(resource.data);

      allow create: if logueado()
                    // Solo campos conocidos, y nace sin asignar ni borrado: la
                    // asignación la hace después un admin o la IA.
                    && request.resource.data.keys().hasOnly([
                         'title', 'description', 'incidentTime', 'urgency', 'status', 'categoria',
                         'assignedTo', 'assignedAt', 'area', 'createdBy', 'createdByUsername',
                         'order', 'code', 'deletedAt', 'createdAt', 'updatedAt', 'problemImages'])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.get('assignedTo', '') == ''
                    && request.resource.data.get('assignedAt', null) == null
                    && request.resource.data.get('deletedAt', null) == null
                    // order = el contador que la MISMA transacción sube en 1 en
                    // config/app, y code = serie + order: así no se repiten.
                    && getAfter(/databases/$(database)/documents/config/app).data.ticketCounter
                         == get(/databases/$(database)/documents/config/app).data.ticketCounter + 1
                    && request.resource.data.order == getAfter(/databases/$(database)/documents/config/app).data.ticketCounter
                    && request.resource.data.code.matches(
                         get(/databases/$(database)/documents/config/app).data.series
                         + '-0*' + string(request.resource.data.order))
                    && (!('createdByUsername' in request.resource.data)
                        || request.resource.data.createdByUsername == usernameDe(request.auth.uid))
                    && request.resource.data.incidentTime is timestamp
                    // La urgencia inicial de un usuario es MEDIO; la ajusta la IA o un admin.
                    && (esAdmin() || request.resource.data.urgency == 'MEDIO')
                    && nonEmptyStr(request.resource.data.title, 200)
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 5000
                    && request.resource.data.urgency in ['CRITICO', 'ALTO', 'MEDIO', 'BAJO']
                    // Todo ticket nace "pendiente" — si no, se saltea toda la
                    // máquina de estados de abajo (que solo corre en update).
                    && request.resource.data.status == 'pendiente'
                    && request.resource.data.code is string
                    && request.resource.data.order is int
                    && (!('categoria' in request.resource.data)
                        || request.resource.data.categoria == ''
                        || nonEmptyStr(request.resource.data.categoria, 120))
                    && (!('area' in request.resource.data)
                        || request.resource.data.area == ''
                        || nonEmptyStr(request.resource.data.area, 120))
                    && (!('problemImages' in request.resource.data)
                        || (request.resource.data.problemImages is list
                            && request.resource.data.problemImages.size() <= 5))
                    && (request.resource.data.get('problemImages', []).size() == 0 || puedeSubirImagenes());

      // Modificar un ticket (estado, urgencia, asignación, etc.) es acción de
      // gestión, no de reporte -- exige admin/super_admin. Cerrar un ticket a
      // 'terminado' exige dejar la descripción de la solución (mismo criterio
      // que el update de técnico de abajo).
      allow update: if esAdmin()
                    && firmaValida()
                    && nonEmptyStr(request.resource.data.title, 200)
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 5000
                    && request.resource.data.urgency in ['CRITICO', 'ALTO', 'MEDIO', 'BAJO']
                    && request.resource.data.status in ['pendiente', 'asignado', 'en_proceso', 'terminado']
                    && transicionDeEstadoValida(resource.data.status, request.resource.data.status)
                    && (request.resource.data.status != 'terminado'
                        || nonEmptyStr(request.resource.data.solutionDescription, 5000))
                    // code, order y createdBy son inmutables tras crearse
                    && request.resource.data.code == resource.data.code
                    && request.resource.data.order == resource.data.order
                    && request.resource.data.createdBy == resource.data.createdBy
                    && (request.resource.data.get('area', '') == ''
                        || nonEmptyStr(request.resource.data.area, 120))
                    && (request.resource.data.get('categoria', '') == ''
                        || nonEmptyStr(request.resource.data.categoria, 120))
                    && ((!agregaImagenes('problemImages') && !agregaImagenes('solutionImages'))
                        || puedeSubirImagenes());

      // El técnico asignado (cuenta "usuario" con personalId vinculado) puede
      // cerrar/reabrir SOLO su propio ticket asignado, y SOLO tocando estado +
      // solución + imágenes de solución. hasOnly() sobre el diff es
      // allow-list: ningún otro campo puede cambiar, lo conozca esta regla o no.
      allow update: if logueado()
                    && miPersonalId() != ''
                    && resource.data.get('assignedTo', '') == miPersonalId()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'solutionDescription', 'solutionImages', 'finishedAt', 'updatedAt', 'modificadoPor'])
                    && firmaValida()
                    && request.resource.data.status in ['pendiente', 'asignado', 'en_proceso', 'terminado']
                    && transicionDeEstadoValida(resource.data.status, request.resource.data.status)
                    && (request.resource.data.status != 'terminado'
                        || nonEmptyStr(request.resource.data.solutionDescription, 5000))
                    && (!('solutionDescription' in request.resource.data)
                        || (request.resource.data.solutionDescription is string
                            && request.resource.data.solutionDescription.size() <= 5000))
                    && (!('solutionImages' in request.resource.data)
                        || (request.resource.data.solutionImages is list
                            && request.resource.data.solutionImages.size() <= 5))
                    && (!agregaImagenes('solutionImages') || puedeSubirImagenes());

      // Borrado físico: solo un admin y solo desde la papelera.
      allow delete: if esAdmin() && resource.data.get('deletedAt', null) != null;

      // ── eventos (historial automático + comentarios) ──────────────────────
      // Los crea el cliente, firmados por quien escribe: comentarios, o
      // eventos tipo "sistema" (cambio de estado, asignación...) en el mismo
      // batch que modifica el ticket. Los de la IA los escribe la Admin SDK.
      // Mismo criterio de visibilidad que el ticket padre.
      match /eventos/{eventoId} {
        allow read: if logueado()
                    && puedeVerTicket(get(rutaTicket(ticketId)).data);
        allow create: if logueado()
                      && puedeVerTicket(getAfter(rutaTicket(ticketId)).data)
                      && request.resource.data.actorId == request.auth.uid
                      && request.resource.data.actorNombre == usernameDe(request.auth.uid)
                      && request.resource.data.createdAt == request.time
                      && (
                           (request.resource.data.tipo == 'comentario'
                            && request.resource.data.keys().hasOnly(['tipo', 'texto', 'imagenes', 'actorId',
                                                                     'actorNombre', 'createdAt'])
                            && nonEmptyStr(request.resource.data.texto, 2000)
                            && (!('imagenes' in request.resource.data)
                                || (request.resource.data.imagenes is list
                                    && request.resource.data.imagenes.size() <= 5
                                    && (request.resource.data.imagenes.size() == 0 || puedeSubirImagenes()))))
                           || (request.resource.data.tipo == 'sistema'
                               && request.resource.data.keys().hasOnly(['tipo', 'mensaje', 'clave', 'actorId',
                                                                        'actorNombre', 'actorTipo', 'orden', 'createdAt'])
                               && request.resource.data.actorTipo == 'usuario'
                               && nonEmptyStr(request.resource.data.mensaje, 500)
                               && request.resource.data.get('clave', 'asignacion') == 'asignacion'
                               && request.resource.data.orden is int
                               && ticketCambiadoAhora(ticketId)
                               // Un evento de asignación exige que la asignación cambie.
                               && (request.resource.data.get('clave', '') != 'asignacion'
                                   || getAfter(rutaTicket(ticketId)).data.get('assignedTo', '')
                                      != get(rutaTicket(ticketId)).data.get('assignedTo', '')))
                         );
        allow update: if false;
        // Se borran junto con el ticket, al eliminarlo definitivamente.
        allow delete: if esAdmin() && get(rutaTicket(ticketId)).data.get('deletedAt', null) != null;
      }
    }

    // ── notificaciones (in-app, por usuario) ──────────────────────────────────
    // Las crea el cliente para OTROS usuarios, solo junto con lo que las
    // origina en la misma escritura: el ticket (creado o modificado) o el
    // comentario (eventoId) de quien escribe, y solo a quien participa del
    // ticket (destinatarioValido). Así nadie puede mandar notificaciones
    // sueltas ni a cualquiera. El destinatario solo lee las suyas y las marca
    // como leídas (con expiraEn: la TTL policy las borra a los 7 días).
    match /notificaciones/{notifId} {
      allow read: if logueado() && request.auth.uid == resource.data.userId;
      allow create: if logueado()
                    && request.resource.data.keys().hasOnly(['userId', 'ticketId', 'ticketCode', 'mensaje',
                                                             'eventoId', 'leida', 'createdAt'])
                    && nonEmptyStr(request.resource.data.userId, 128)
                    && request.resource.data.userId != request.auth.uid
                    && nonEmptyStr(request.resource.data.ticketId, 128)
                    && nonEmptyStr(request.resource.data.mensaje, 500)
                    && request.resource.data.leida == false
                    && request.resource.data.createdAt == request.time
                    && puedeVerTicket(getAfter(rutaTicket(request.resource.data.ticketId)).data)
                    && request.resource.data.ticketCode == getAfter(rutaTicket(request.resource.data.ticketId)).data.code
                    && destinatarioValido(request.resource.data.userId, getAfter(rutaTicket(request.resource.data.ticketId)).data)
                    && (
                         // Ticket recién creado (createdAt) o modificado y firmado ahora.
                         getAfter(rutaTicket(request.resource.data.ticketId)).data.get('createdAt', null) == request.time
                         || ticketCambiadoAhora(request.resource.data.ticketId)
                         || (nonEmptyStr(request.resource.data.get('eventoId', ''), 128)
                             && getAfter(/databases/$(database)/documents/tickets/$(request.resource.data.ticketId)/eventos/$(request.resource.data.eventoId)).data.actorId == request.auth.uid
                             && getAfter(/databases/$(database)/documents/tickets/$(request.resource.data.ticketId)/eventos/$(request.resource.data.eventoId)).data.createdAt == request.time)
                       );
      allow update: if logueado()
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida', 'expiraEn'])
                    && request.resource.data.leida is bool
                    && (!('expiraEn' in request.resource.data)
                        || (request.resource.data.expiraEn is timestamp
                            && request.resource.data.expiraEn < request.time + duration.value(8, 'd')));
      allow delete: if false;
    }

    // ── personal (empleados a los que se asignan tickets) ─────────────────────
    match /personal/{personalId} {
      allow read: if logueado();
      allow create, update: if esAdmin()
                            && nonEmptyStr(request.resource.data.nombre, 120)
                            && request.resource.data.activo is bool
                            && request.resource.data.get('tecnico', true) is bool;
      // Borrado físico: solo un admin y solo desde la papelera.
      allow delete: if esAdmin() && resource.data.get('deletedAt', null) != null;
    }

    // ── catálogos: cargos, áreas y categorías de ticket ──────────────────────
    match /cargos/{cargoId} {
      allow read: if logueado();
      allow create, update: if esAdmin()
                            && nonEmptyStr(request.resource.data.nombre, 120)
                            && request.resource.data.activo is bool;
      allow delete: if esAdmin() && resource.data.get('deletedAt', null) != null;
    }

    match /areas/{areaId} {
      allow read: if logueado();
      allow create, update: if esAdmin()
                            && nonEmptyStr(request.resource.data.nombre, 120)
                            && request.resource.data.activo is bool;
      allow delete: if esAdmin() && resource.data.get('deletedAt', null) != null;
    }

    match /categorias/{categoriaId} {
      allow read: if logueado();
      allow create, update: if esAdmin()
                            && nonEmptyStr(request.resource.data.nombre, 120)
                            && request.resource.data.activo is bool;
      allow delete: if esAdmin() && resource.data.get('deletedAt', null) != null;
    }

    // ── access (matriz de permisos por sección) ──────────────────────────────
    match /access/{userId} {
      // Cada quien lee su propia matriz; los admins, todas.
      allow read: if logueado() && (request.auth.uid == userId || esAdmin());
      function seccionesValidas() {
        return request.resource.data.sections is map
              && request.resource.data.sections.dashboard is bool
              && request.resource.data.sections.tickets is bool
              && request.resource.data.sections.personal is bool
              && request.resource.data.sections.administracion is bool
              && request.resource.data.sections.notificaciones is bool
              && request.resource.data.sections.papelera is bool
              && request.resource.data.sections.historico is bool
              && request.resource.data.sections.get('subirImagenes', false) is bool;
      }
      // Lo crea un admin junto con la cuenta (o al reparar un access
      // faltante), o el primer super_admin para sí mismo durante el setup.
      // Los accesos de un admin, un super_admin o una cuenta protegida solo
      // los cambia un super_admin (de un admin, en la práctica, solo importa
      // "subirImagenes": las secciones las tiene siempre).
      // Se mira la cuenta como queda DESPUÉS de la escritura (getAfter): si
      // un batch crea la cuenta y su access juntos, cuenta el rol nuevo.
      function cuentaIntocable() {
        let u = /databases/$(database)/documents/users/$(userId);
        return existsAfter(u)
               && (getAfter(u).data.get('protegida', false) == true
                   || getAfter(u).data.role in ['admin', 'super_admin']);
      }
      allow create: if seccionesValidas()
                    && ((enSetup() && userId == request.auth.uid)
                        || (esAdmin() && (!cuentaIntocable() || rol() == 'super_admin')));
      allow update: if esAdmin()
                    && seccionesValidas()
                    && (!cuentaIntocable() || rol() == 'super_admin');
      allow delete: if false;
    }

    // ── config (singleton 'app') ─────────────────────────────────────────────
    match /config/{docId} {
      allow read: if logueado();
      // create: solo el setup inicial (una única vez, junto con el primer
      // super_admin y publico/estado), con el contador en 0.
      allow create: if docId == 'app'
                    && enSetup()
                    && request.resource.data.keys().hasOnly(['ticketCounter', 'series', 'assignmentMode',
                                                             'maxTicketsAbiertos', 'updatedAt'])
                    && request.resource.data.ticketCounter == 0
                    && serieValida(request.resource.data.series)
                    && request.resource.data.assignmentMode in ['ia', 'manual']
                    && request.resource.data.maxTicketsAbiertos is int
                    && request.resource.data.maxTicketsAbiertos >= 1;
      // update exige rol admin/super_admin (config global). Excepción: el
      // contador de tickets lo sube CUALQUIER usuario autenticado, en la
      // misma transacción de crear un ticket — y solo de a 1 (nadie puede
      // resetearlo y duplicar códigos de ticket).
      allow update: if request.resource.data.assignmentMode in ['ia', 'manual']
                    && serieValida(request.resource.data.series)
                    && request.resource.data.ticketCounter is int
                    && (request.resource.data.ticketCounter == resource.data.ticketCounter
                        || request.resource.data.ticketCounter == resource.data.ticketCounter + 1)
                    && (!('maxTicketsAbiertos' in request.resource.data)
                        || (request.resource.data.maxTicketsAbiertos is int
                            && request.resource.data.maxTicketsAbiertos >= 1))
                    && (!('slaHoras' in request.resource.data)
                        || (request.resource.data.slaHoras is map
                            && request.resource.data.slaHoras.keys().hasOnly(['CRITICO', 'ALTO', 'MEDIO', 'BAJO'])))
                    && (
                         esAdmin()
                         || (logueado()
                             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ticketCounter', 'updatedAt']))
                       );
      allow delete: if false;
    }

    // ── publico/estado: única lectura sin sesión ─────────────────────────────
    // Solo {inicializado: true}; se crea una única vez, en el setup inicial.
    match /publico/{docId} {
      allow read: if docId == 'estado';
      allow create: if docId == 'estado'
                    && enSetup()
                    && request.resource.data.keys().hasOnly(['inicializado'])
                    && request.resource.data.inicializado == true;
      allow update, delete: if false;
    }

    // Todo lo demás: denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
